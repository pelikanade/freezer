# Template for services.freezer.environmentFile.
#
#   install -m 600 deploy/freezer.example.env /run/secrets/freezer-environment
#
# systemd reads this file as root before dropping to the freezer user, so it can
# be root:root mode 0600. It is a runtime path, never a Nix path or a store
# object. One KEY=value per line; systemd does not expand or unquote the values.
#
# Commit statuses for every registered repository.
GITHUB_TOKEN=REPLACE_WITH_A_GITHUB_TOKEN
# Cloudflare R2 API token with Object Read & Write on the cache bucket, used by
# Nix's S3 store. R2 ignores the region; Freezer sends auto.
AWS_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
