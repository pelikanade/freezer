# Environment for the Freezer container, passed by EnvironmentFile= in
# deploy/freezer.container (Podman turns that into --env-file). Mode 0600.
# One KEY=value per line; comment lines start with #. Neither Podman nor Docker
# expands or unquotes values here, so the values are taken literally.
#
# Commit statuses for every registered repository.
GITHUB_TOKEN=REPLACE_WITH_A_GITHUB_TOKEN
# Cloudflare R2 API token (Object Read & Write on the cache bucket), used by
# Nix's S3 store. R2 ignores the region; freezer sends auto.
AWS_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
